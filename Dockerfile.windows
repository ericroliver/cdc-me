# escape=`
# ─────────────────────────────────────────────────────────────────────────────
# DTAI / CDC Testing Framework API — Windows container image (ltsc2022)
#
# Windows twin of ./Dockerfile (Linux multi-arch). Same runtime contract:
#   * publishes cdc-api (framework-dependent), runs `dotnet cdc-api.dll`
#   * flat env vars (read via Environment.GetEnvironmentVariable in cdc-lib):
#       TEST_DB_CONNECTION  / TEST_DB_PROVIDER   (default provider SqlServer)
#       CDCME_DB_CONNECTION / CDCME_DB_PROVIDER  (default provider PostgreSQL)
#   * GET /health for liveness (VersionHealthCheck only — does not touch DBs)
#
# Windows differences vs the Linux Dockerfile:
#   * Base images are windowsservercore-ltsc2022 (the pod host runs ltsc2022;
#     same tag family as the pod's enigma-api and vibe-dev images).
#   * No openssl.cnf copy / apk add icu — Windows NLS covers globalization.
#   * Healthcheck uses Windows PowerShell (no wget/curl on servercore).
#   * Runs as ContainerUser (least privilege — the API only needs to reach the
#     DBs over the network; no local writes). Flip to ContainerAdministrator
#     if a local-write need ever appears.
#
# Pod wiring — enigma-pod-dpsol-compose.yml service `dtai-api`:
#   * joins network `dpsol`
#   * DBs live on the pod `sql-server` service; SQL-only profile:
#     TEST_DB_PROVIDER=CDCME_DB_PROVIDER=SqlServer
#   * the CDCME factory schema is auto-created by DbUp on startup
#
# Build (host paths — the pod binds C:\Users\0e0e0\enigma-pod-dpsol; build
# context is resolved by the HOST daemon, so pass the host path):
#   docker build -f C:\Users\0e0e0\enigma-pod-dpsol\repos\dtai\Dockerfile.windows ^
#     -t cdc-api:windows --build-arg VERSION=1.0.5 ^
#     C:\Users\0e0e0\enigma-pod-dpsol\repos\dtai
# ─────────────────────────────────────────────────────────────────────────────

ARG DOTNET_VERSION=10.0
ARG WINDOWS_TAG=windowsservercore-ltsc2022

# ── Build stage ──────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-${WINDOWS_TAG} AS build
WORKDIR C:/src

ARG VERSION=1.0.0
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

# Copy project files first so restore is layer-cached (same set as Linux)
COPY cdc-api/cdc-api.csproj cdc-api/
COPY cdc-lib/cdc-lib.csproj cdc-lib/
COPY cdc-models/cdc-models.csproj cdc-models/
COPY cdc-cli/cdc-cli.csproj cdc-cli/
COPY cdc-proto/cdc-utility.csproj cdc-proto/
COPY cdc-api.Tests/cdc-api.Tests.csproj cdc-api.Tests/
COPY cdc-cli.Tests/cdc-cli.Tests.csproj cdc-cli.Tests/
COPY cdc-me.sln .

# Restore the full solution (incl. test projects — mirrors Linux)
RUN dotnet restore cdc-me.sln

# Copy everything else and build the solution.
# NOTE: %VAR% — cmd (the default Windows shell) expands ARG values.
COPY . .
RUN dotnet build cdc-me.sln -c Release --no-restore -p:Version=%VERSION% -p:InformationalVersion=%VERSION%+sha.%GIT_COMMIT%

# Publish the API (framework-dependent — the runtime stage ships ASP.NET)
RUN dotnet publish cdc-api/cdc-api.csproj -c Release --no-restore --self-contained false -p:UseAppHost=false -p:Version=%VERSION% -p:InformationalVersion=%VERSION%+sha.%GIT_COMMIT% -o C:/app/publish

# ── Runtime stage ────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}-${WINDOWS_TAG} AS runtime
WORKDIR C:/app
COPY --from=build C:/app/publish .

# Build metadata, exposed by the version endpoint (mirrors the Linux image)
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ENV GIT_COMMIT=${GIT_COMMIT}
ENV BUILD_DATE=${BUILD_DATE}

# ── Environment ──────────────────────────────────────────────────────────────
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_NOLOGO=1

EXPOSE 8080

# Liveness: /health (VersionHealthCheck only; does not touch the DBs).
# Windows PowerShell — no wget/curl on servercore. Deliberately contains no `$`
# so a docker-compose healthcheck override can copy it verbatim ($ would be
# interpolated/composed away by compose — see the pod's enigma-api comment).
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 `
  CMD ["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "if ((Invoke-WebRequest -UseBasicParsing -Uri http://localhost:8080/health -TimeoutSec 5).StatusCode -ne 200) { exit 1 }"]

USER ContainerUser

# Metadata (mirrors the Linux image labels)
LABEL org.opencontainers.image.title="CDC Testing Framework API (Windows)" `
      org.opencontainers.image.description="A .NET Web API for database change validation using SQL Server CDC functionality" `
      org.opencontainers.image.vendor="AAIF" `
      org.opencontainers.image.licenses="MIT"

ENTRYPOINT ["dotnet", "cdc-api.dll"]
