<Project>

  <!-- Versioning: single source of truth for all projects in this repo. -->
  <!-- CI/CD overrides via -p:Version=... -p:InformationalVersion=... -->
  <!-- Local dev uses these defaults. -->
  <PropertyGroup>
    <VersionPrefix>1.0.5</VersionPrefix>
    <VersionSuffix Condition="'$(GITHUB_RUN_NUMBER)' != ''">dev.$(GITHUB_RUN_NUMBER)</VersionSuffix>
    <Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
    <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion Condition="'$(GIT_COMMIT)' != ''">$(Version)+sha.$(GIT_COMMIT)</InformationalVersion>
    <InformationalVersion Condition="'$(GIT_COMMIT)' == ''">$(Version)</InformationalVersion>
    <Company>AAIF</Company>
    <Product>DTAI</Product>
  </PropertyGroup>

</Project>
