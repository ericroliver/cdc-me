# Database Connection Strings
# Copy this file to .env and fill in your actual values
# DO NOT COMMIT .env TO SOURCE CONTROL

# TEST_DB - SQL Server database under test (CDC/traces enabled)
# This is the database where CDC and Extended Events are configured
TEST_DB_CONNECTION=Server=your-sqlserver-host;Database=your-test-database;User Id=your-username;Password=your-password;TrustServerCertificate=true;

# CDCME_DB - PostgreSQL database for storing trace data and CDC snapshots
# This is where trace sessions, events, and comparison results are stored
CDCME_DB_CONNECTION=Host=your-postgres-host;Database=cdcme;Username=your-postgres-username;Password=your-postgres-password

# Optional: Override database types (defaults: TEST_DB=SqlServer, CDCME_DB=PostgreSQL)
TEST_DB_PROVIDER=SqlServer
CDCME_DB_PROVIDER=PostgreSQL

# ============================================================================
# Docker Compose Configuration
# ============================================================================

# Application Settings
VERSION=1.0.0
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# SQL Server Configuration
SQL_PORT=1433
SQL_SA_PASSWORD=YourStrong@Passw0rd
SQL_PID=Developer

# PostgreSQL Configuration
POSTGRES_PORT=5432
POSTGRES_DB=cdcme
POSTGRES_USER=cdcme
POSTGRES_PASSWORD=cdcme_password

# pgAdmin Configuration (Development only)
PGADMIN_EMAIL=admin@cdcme.local
PGADMIN_PASSWORD=admin

# ============================================================================
# Docker Compose Connection Strings (for containerized environments)
# ============================================================================
# Uncomment these when using docker-compose and comment out the ones above

# TEST_DB_CONNECTION=Server=sqlserver;Database=CdcTestDB;User Id=sa;Password=${SQL_SA_PASSWORD};TrustServerCertificate=true;
# CDCME_DB_CONNECTION=Host=postgres;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}