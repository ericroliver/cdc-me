# Database Connection Strings
# Copy this file to .env and fill in your actual values
# ⚠️ CRITICAL SECURITY WARNING: DO NOT COMMIT .env TO SOURCE CONTROL ⚠️

# TEST_DB - SQL Server database under test (CDC/traces enabled)
# This is the database where CDC and Extended Events are configured
#
# ⚠️ SECURITY WARNING: TrustServerCertificate=true bypasses SSL certificate validation
# - Use ONLY in development/testing environments
# - In production, use TrustServerCertificate=false and proper SSL certificates
# - See SECURITY.md for production configuration guidelines
TEST_DB_CONNECTION=Server=your-sqlserver-host;Database=your-test-database;User Id=your-username;Password=<YOUR_SECURE_PASSWORD>;TrustServerCertificate=true;

# CDCME_DB - PostgreSQL database for storing trace data and CDC snapshots
# This is where trace sessions, events, and comparison results are stored
#
# 🔒 SECURITY: Use strong, unique passwords for production environments
CDCME_DB_CONNECTION=Host=your-postgres-host;Database=cdcme;Username=your-postgres-username;Password=<YOUR_SECURE_PASSWORD>

# Optional: Override database types (defaults: TEST_DB=SqlServer, CDCME_DB=PostgreSQL)
TEST_DB_PROVIDER=SqlServer
CDCME_DB_PROVIDER=PostgreSQL

# ============================================================================
# Docker Compose Configuration
# ============================================================================

# Application Settings
VERSION=1.0.0
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# SQL Server Configuration
SQL_PORT=1433
# 🔒 SECURITY: Generate a strong password with at least 12 characters
# Requirements: uppercase, lowercase, numbers, and special characters
# Example generation: openssl rand -base64 32
# ⚠️ NEVER use default or weak passwords like 'Password123'
SQL_SA_PASSWORD=<CHANGE_ME_STRONG_PASSWORD_REQUIRED>
SQL_PID=Developer

# PostgreSQL Configuration
POSTGRES_PORT=5432
POSTGRES_DB=cdcme
POSTGRES_USER=cdcme
# 🔒 SECURITY: Generate a strong password with at least 12 characters
# Example generation: openssl rand -base64 32
# ⚠️ NEVER use default or weak passwords
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD_REQUIRED>

# pgAdmin Configuration (Development only - NOT for production)
PGADMIN_EMAIL=admin@cdcme.local
# 🔒 SECURITY: Change this default password immediately
PGADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD_REQUIRED>

# ============================================================================
# Docker Compose Connection Strings (for containerized environments)
# ============================================================================
# Uncomment these when using docker-compose and comment out the ones above

# TEST_DB_CONNECTION=Server=sqlserver;Database=CdcTestDB;User Id=sa;Password=${SQL_SA_PASSWORD};TrustServerCertificate=true;
# CDCME_DB_CONNECTION=Host=postgres;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}